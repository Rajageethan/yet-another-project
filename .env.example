DATABASE_URL="file:./prisma/dev.db"

# Auth.js secret: generate with `npx auth secret`
AUTH_SECRET=""
# Local dev only: sign in with just a name + email (ignored in production)
AUTH_DEV_LOGIN="true"
# Optional OAuth providers (leave empty to hide the buttons)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Groq (free tier): https://console.groq.com/keys
# Shared key for all users. Leave empty to require each student to add their own in Settings.
GROQ_API_KEY=""
GROQ_MENTOR_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"
# Reasoning effort for mentor replies on gpt-oss models: low | medium | high (default high)
GROQ_MENTOR_REASONING="high"
# Mentor replies per user per day on the shared key (a user's own key has no cap)
DAILY_TURN_CAP="60"

# Who can open /admin/review (dev only). Empty = any signed-in user in development.
ADMIN_EMAILS=""
