 "referenceSolution": "class Solution:\n    def nextGreaterElements(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        ans = [-1] * n\n        stk = []\n        for i in range(n * 2 - 1, -1, -1):\n            i %= n\n            while stk and stk[-1] <= nums[i]:\n                stk.pop()\n            if stk:\n                ans[i] = stk[-1]\n            stk.append(nums[i])\n        return ans\n",
