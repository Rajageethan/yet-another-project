 "referenceSolution": "class Solution:\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\n        for row in matrix:\n            j = bisect_left(row, target)\n            if j < len(matrix[0]) and row[j] == target:\n                return True\n        return False\n",
