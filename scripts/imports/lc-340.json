 "referenceSolution": "class Solution:\n    def lengthOfLongestSubstringKDistinct(self, s: str, k: int) -> int:\n        l = 0\n        cnt = Counter()\n        for c in s:\n            cnt[c] += 1\n            if len(cnt) > k:\n                cnt[s[l]] -= 1\n                if cnt[s[l]] == 0:\n                    del cnt[s[l]]\n                l += 1\n        return len(s) - l\n",
