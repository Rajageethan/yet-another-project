 "referenceSolution": "class Solution:\n    def longestConsecutive(self, nums: List[int]) -> int:\n        s = set(nums)\n        ans = 0\n        d = defaultdict(int)\n        for x in nums:\n            y = x\n            while y in s:\n                s.remove(y)\n                y += 1\n            d[x] = d[y] + y - x\n            ans = max(ans, d[x])\n        return ans\n",
 "draft": null
