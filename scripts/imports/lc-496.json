 "referenceSolution": "class Solution:\n    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:\n        stk = []\n        d = {}\n        for x in nums2[::-1]:\n            while stk and stk[-1] < x:\n                stk.pop()\n            if stk:\n                d[x] = stk[-1]\n            stk.append(x)\n        return [d.get(x, -1) for x in nums1]\n",
 "draft": null
