 "referenceSolution": "class Solution:\n    def nthUglyNumber(self, n: int) -> int:\n        h = [1]\n        vis = {1}\n        ans = 1\n        for _ in range(n):\n            ans = heappop(h)\n            for v in [2, 3, 5]:\n                nxt = ans * v\n                if nxt not in vis:\n                    vis.add(nxt)\n                    heappush(h, nxt)\n        return ans\n",
