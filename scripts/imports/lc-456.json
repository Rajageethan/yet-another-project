 "referenceSolution": "class Solution:\n    def find132pattern(self, nums: List[int]) -> bool:\n        vk = -inf\n        stk = []\n        for x in nums[::-1]:\n            if x < vk:\n                return True\n            while stk and stk[-1] < x:\n                vk = stk.pop()\n            stk.append(x)\n        return False\n",
