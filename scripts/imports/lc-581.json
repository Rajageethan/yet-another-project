 "referenceSolution": "class Solution:\n    def findUnsortedSubarray(self, nums: List[int]) -> int:\n        arr = sorted(nums)\n        l, r = 0, len(nums) - 1\n        while l <= r and nums[l] == arr[l]:\n            l += 1\n        while l <= r and nums[r] == arr[r]:\n            r -= 1\n        return r - l + 1\n",
