 "referenceSolution": "class Solution:\n    def minSubArrayLen(self, target: int, nums: List[int]) -> int:\n        n = len(nums)\n        s = list(accumulate(nums, initial=0))\n        ans = n + 1\n        for i, x in enumerate(s):\n            j = bisect_left(s, x + target)\n            if j <= n:\n                ans = min(ans, j - i)\n        return ans if ans <= n else 0\n",
