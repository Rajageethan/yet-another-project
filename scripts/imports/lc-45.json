 "referenceSolution": "class Solution:\n    def jump(self, nums: List[int]) -> int:\n        ans = mx = last = 0\n        for i, x in enumerate(nums[:-1]):\n            mx = max(mx, i + x)\n            if last == i:\n                ans += 1\n                last = mx\n        return ans\n",
