 "referenceSolution": "class Solution:\n    def numSquares(self, n: int) -> int:\n        m = int(sqrt(n))\n        f = [[inf] * (n + 1) for _ in range(m + 1)]\n        f[0][0] = 0\n        for i in range(1, m + 1):\n            for j in range(n + 1):\n                f[i][j] = f[i - 1][j]\n                if j >= i * i:\n                    f[i][j] = min(f[i][j], f[i][j - i * i] + 1)\n        return f[m][n]\n",
