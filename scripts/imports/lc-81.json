 "referenceSolution": "class Solution:\n    def search(self, nums: List[int], target: int) -> bool:\n        n = len(nums)\n        l, r = 0, n - 1\n        while l < r:\n            mid = (l + r) >> 1\n            if nums[mid] > nums[r]:\n                if nums[l] <= target <= nums[mid]:\n                    r = mid\n                else:\n                    l = mid + 1\n            elif nums[mid] < nums[r]:\n                if nums[mid] < target <= nums[r]:\n                    l = mid + 1\n                else:\n                    r = mid\n            else:\n                r -= 1\n        return nums[l] == target\n",
