 },
 "referenceSolution": "class Solution:\n    def kSmallestPairs(\n        self, nums1: List[int], nums2: List[int], k: int\n    ) -> List[List[int]]:\n        q = [[u + nums2[0], i, 0] for i, u in enumerate(nums1[:k])]\n        heapify(q)\n        ans = []\n        while q and k > 0:\n            _, i, j = heappop(q)\n            ans.append([nums1[i], nums2[j]])\n            k -= 1\n            if j + 1 < len(nums2):\n                heappush(q, [nums1[i] + nums2[j + 1], i, j + 1])\n        return ans\n",
 "draft": null
}