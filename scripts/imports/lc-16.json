 "referenceSolution": "class Solution:\n    def threeSumClosest(self, nums: List[int], target: int) -> int:\n        nums.sort()\n        n = len(nums)\n        ans = inf\n        for i, v in enumerate(nums):\n            j, k = i + 1, n - 1\n            while j < k:\n                t = v + nums[j] + nums[k]\n                if t == target:\n                    return t\n                if abs(t - target) < abs(ans - target):\n                    ans = t\n                if t > target:\n                    k -= 1\n                else:\n                    j += 1\n        return ans\n",
 "draft": {
  "title": "Three Sum Closest",
  "statement": "You are given an integer array `nums` and an integer `target`. Choose exactly three distinct elements from `nums` and compute their sum. Return the sum whose value is nearest to `target`. It is guaranteed that a unique best sum exists for every input.\n\nThe function must return that closest sum as an integer. The order of the three chosen numbers does not matter.",
  "constraints": [
   "3 ≤ nums.length ≤ 5×10⁰",
   "-1000 ≤ nums[i] ≤ 1000",
   "-10⁴ ≤ target ≤ 10⁴"
  ],
  "pattern": "Two‑pointer after sorting",
  "mentorNotes": {
   "keyInsight": "Sorting the array lets you move two pointers inward to explore sums efficiently while keeping track of the best distance to the target.",
   "bruteForce": "Check every combination of three indices (i, j, k) with three nested loops – O(n³) time, O(1) extra space.",
   "optimal": "Sort the array then fix one element and use a left‑right two‑pointer scan – O(n²) time, O(1) extra space.",
   "commonMistakes": [
    "Updating the answer only when the current sum is smaller, forgetting to compare absolute differences",
    "Continuing the search after finding a sum exactly equal to target instead of returning immediately",
    "Using the same index twice when moving pointers",
    "Not sorting the array before applying the two‑pointer technique"
   ],
