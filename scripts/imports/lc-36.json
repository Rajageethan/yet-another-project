 "referenceSolution": "class Solution:\n    def isValidSudoku(self, board: List[List[str]]) -> bool:\n        row = [[False] * 9 for _ in range(9)]\n        col = [[False] * 9 for _ in range(9)]\n        sub = [[False] * 9 for _ in range(9)]\n        for i in range(9):\n            for j in range(9):\n                c = board[i][j]\n                if c == '.':\n                    continue\n                num = int(c) - 1\n                k = i // 3 * 3 + j // 3\n                if row[i][num] or col[j][num] or sub[k][num]:\n                    return False\n                row[i][num] = True\n                col[j][num] = True\n                sub[k][num] = True\n        return True\n",
