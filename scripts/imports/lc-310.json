 "referenceSolution": "class Solution:\n    def findMinHeightTrees(self, n: int, edges: List[List[int]]) -> List[int]:\n        if n == 1:\n            return [0]\n        g = [[] for _ in range(n)]\n        degree = [0] * n\n        for a, b in edges:\n            g[a].append(b)\n            g[b].append(a)\n            degree[a] += 1\n            degree[b] += 1\n        q = deque(i for i in range(n) if degree[i] == 1)\n        ans = []\n        while q:\n            ans.clear()\n            for _ in range(len(q)):\n                a = q.popleft()\n                ans.append(a)\n                for b in g[a]:\n                    degree[b] -= 1\n                    if degree[b] == 1:\n                        q.append(b)\n        return ans\n",
 "draft": null
