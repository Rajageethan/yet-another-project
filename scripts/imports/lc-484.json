 "referenceSolution": "class Solution:\n    def findPermutation(self, s: str) -> List[int]:\n        n = len(s)\n        ans = list(range(1, n + 2))\n        i = 0\n        while i < n:\n            j = i\n            while j < n and s[j] == 'D':\n                j += 1\n            ans[i : j + 1] = ans[i : j + 1][::-1]\n            i = max(i + 1, j)\n        return ans\n",
